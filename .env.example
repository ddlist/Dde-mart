APP_NAME="DDE-Mart Admin Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dde-mart-admin.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dde_mart_admin
DB_USERNAME=root
DB_PASSWORD=
# Previous-system database (read-only reference for data migration studies):
# LEGACY_DB_DATABASE=
# LEGACY_DB_HOST=127.0.0.1

# --- DDE-Mart integrations (all empty by default; fill per environment) ---
# Firebase (kreait/laravel-firebase, installed D9). Point at your service-account JSON;
# without it the panel runs fine and push sends are logged as failed, never fatal.
FIREBASE_CREDENTIALS=
# Legacy FCM leftovers (unused by the rebuild; kept as reference for D10 import):
# FIREBASE_PROJECT_ID=
# FCM_SERVER_KEY=

# Google Maps browser key for the Live Map page (optional; page degrades gracefully).
MAPS_KEY=

# Payments — live gateway credentials (D8c). Empty = driver reports unconfigured.
STRIPE_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_ENV=staging
FLW_SECRET_KEY=
PAYOUT_CURRENCY=USD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dde-mart.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
